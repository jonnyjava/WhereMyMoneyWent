{
  "name": "ddd-nextjs-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/checks/check-names.mjs",
    "arch": "node scripts/checks/check-architecture.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:postdeploy": "playwright test --config playwright.postdeploy.config.ts",
    "check:migrations": "node scripts/checks/check-migrations.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db/migrate.mjs",
    "verify:fast": "pnpm typecheck && pnpm lint && pnpm arch && pnpm check:references && pnpm check:plan && pnpm check:ui && pnpm test:plan && pnpm test",
    "verify": "pnpm verify:fast && pnpm test:e2e",
    "prove:guardrails": "bash scripts/proofs/prove-guardrails.sh",
    "test:pipeline": "bash scripts/proofs/test-pipeline-logic.sh",
    "check:references": "node scripts/checks/check-references.mjs",
    "check:plan": "node scripts/plan/check-plan.mjs",
    "test:plan": "node --test \"scripts/plan/**/*.test.mjs\"",
    "plan:preview": "node scripts/plan/sync-issues.mjs --no-remote",
    "new-context": "node scripts/plan/new-context.mjs",
    "check:ui": "node scripts/checks/check-ui.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.5",
    "postgres": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "dependency-cruiser": "^18.7.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vercel": "^65.11.0",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.16.1"
}
