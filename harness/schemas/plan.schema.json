{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/plan.schema.json",
  "title": "Plan",
  "description": "What the planner produces and a person approves: bounded contexts and small tasks, each one ready to become a task issue.",
  "type": "object",
  "required": ["version", "project", "contexts", "tasks"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "source": { "description": "Path of the feature file this plan was made from.", "type": "string" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_parallel": { "description": "At most this many task issues are released (labeled ready) at once.", "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "contexts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/context" }
    },
    "tasks": {
      "description": "In the order they should be released. Dependencies still decide what may start.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "context": {
      "type": "object",
      "required": ["name", "purpose", "status"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "purpose": { "type": "string", "minLength": 1 },
        "status": { "description": "existing: the folder is already in src/contexts. proposed: a person creates it with new-context before its tasks can be released.", "enum": ["existing", "proposed"] },
        "terms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["term", "meaning"],
            "additionalProperties": false,
            "properties": { "term": { "type": "string", "minLength": 1 }, "meaning": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "task": {
      "type": "object",
      "required": ["id", "title", "feature", "context", "goal", "criteria", "out_of_scope", "open_questions", "depends_on", "size"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^T-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "feature": { "type": "string", "pattern": "^F-[0-9]{3}$" },
        "context": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "goal": { "type": "string", "minLength": 1, "maxLength": 300 },
        "criteria": { "description": "Observable behaviors, one per item, including the failure behavior.", "type": "array", "minItems": 1, "maxItems": 7, "items": { "type": "string", "minLength": 1 } },
        "out_of_scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "open_questions": { "description": "A task with open questions is never released.", "type": "array", "items": { "type": "string", "minLength": 1 } },
        "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^T-[0-9]{3}$" } },
        "size": { "description": "S or M. A task that is bigger must be split.", "enum": ["S", "M"] }
      }
    }
  }
}
